{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMD",
  "version": "0.2.4",
  "identifier": "labs.northwolf.omd",
  "build": {
    "beforeBuildCommand": "vp build --config vite.v2.config.ts",
    "frontendDist": "../dist-v2"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "devtools": false,
        "title": "OMD",
        "url": "v2.html",
        "width": 1340,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' blob: data:",
        "media-src": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utilities",
    "publisher": "North Wolf Labs LLC",
    "copyright": "© 2026 North Wolf Labs LLC",
    "resources": [
      "resources/v2/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
